;; Goku config — generates the "Goku" profile in karabiner.json.
;; Run `goku` (or `goku -A` for dry-run) after editing.
;; Tutorial: https://github.com/yqrashawn/GokuRakuJoudo/blob/master/tutorial.md

{:profiles
 {:Goku {:default true :selected true
         ;; :held -> spacebar held this many ms with no other key -> layer on.
         :held 200}}

 :applications
 {:emacs ["^org\\.gnu\\.Emacs$"]
  :terms ["^com\\.googlecode\\.iterm2$"
          "^com\\.mitchellh\\.ghostty$"]}

 ;; Only the MacBook built-in keyboard needs the QWERTY -> Dvorak remap;
 ;; my external keyboards (e.g. Glove80) already type Dvorak in hardware.
 :devices
 {:builtin [{:is_built_in_keyboard true}]}

 :main
 [;; Lower layer — hold spacebar to activate, tap alone sends space.
  ;; Mirrors the Glove80 hardware Lower layer for the MacBook built-in keyboard.
  ;; Must precede the Dvorak remap so position-based mappings win.
  {:des "Lower layer (hold spacebar)"
   :rules [;; Trigger:
           ;;   :held    — key still down at :held threshold       -> set "lower" (layer on)
           ;;   :afterup — key release (always)                    -> clear "lower"
           ;;   :alone   — clean tap-release, no other key pressed -> emit a space
           ;; Plain to_if_alone. Rolled keys (typing space and the next key with
           ;; overlap) can occasionally swallow the space because Karabiner skips
           ;; :alone whenever any other key was pressed during the hold; that's a
           ;; deliberate trade vs. the unreliable spaces we got from the fork's
           ;; per-to-event-conditions on :canceled.
           [:spacebar nil [:builtin]
            {:held    ["lower" 1]
             :afterup ["lower" 0]
             :alone   :spacebar}]
           ;; Layered remaps (each requires lower=1 AND built-in keyboard).
           [:tab          :mute              [["lower" 1] :builtin]]
           [:q            :volume_decrement  [["lower" 1] :builtin]]
           [:w            :volume_increment  [["lower" 1] :builtin]]
           [:e            :!Sopen_bracket    [["lower" 1] :builtin]]   ;; {
           [:r            :!Sclose_bracket   [["lower" 1] :builtin]]   ;; }
           [:a            :!CSopen_bracket   [["lower" 1] :builtin]]   ;; ⌘⇧[
           [:s            :!CSclose_bracket  [["lower" 1] :builtin]]   ;; ⌘⇧]
           [:d            :open_bracket      [["lower" 1] :builtin]]   ;; [
           [:f            :close_bracket     [["lower" 1] :builtin]]   ;; ]
           [:c            :down_arrow        [["lower" 1] :builtin]]
           [:v            :up_arrow          [["lower" 1] :builtin]]
           [:5            :home              [["lower" 1] :builtin]]
           [:t            :page_up           [["lower" 1] :builtin]]
           [:g            :page_down         [["lower" 1] :builtin]]
           [:b            :end               [["lower" 1] :builtin]]
           [:j            :left_arrow        [["lower" 1] :builtin]]
           [:p            :right_arrow       [["lower" 1] :builtin]]
           [:o            :!S8               [["lower" 1] :builtin]]   ;; *
           [:l            :!Sequal_sign      [["lower" 1] :builtin]]   ;; +
           [:semicolon    :equal_sign        [["lower" 1] :builtin]]   ;; =
           ]}

  {:des "Emacs-style ctrl bindings (outside terminals/Emacs)"
   ;; Goku only writes complex_modifications. Karabiner has an earlier stage,
   ;; simple_modifications, which runs *before* complex rules — the old "My
   ;; Dvorak" profile put the Dvorak remap there, so by the time these emacs
   ;; rules saw a keypress it had already been rewritten to the Dvorak letter.
   ;; In Goku we can't use that earlier stage, and complex rules don't chain
   ;; (later rules don't see earlier rules' output), so we can't catch both
   ;; hardware-Dvorak boards (which emit Dvorak letters) and the built-in
   ;; MacBook (which emits QWERTY scancodes) with a single rule. Two parallel
   ;; sets, scoped by device.
   :rules [;; External / hardware-Dvorak keyboards: match the Dvorak letter directly.
           [:!Tw :!Odelete_or_backspace [:!emacs :!terms :!builtin]]
           [:!Tb :!Oleft_arrow          [:!emacs :!terms :!builtin]]
           [:!Tf :!Oright_arrow         [:!emacs :!terms :!builtin]]
           [:!Th :delete_or_backspace   [:!emacs :!builtin]]
           ;; Built-in MacBook: match the QWERTY position of the Dvorak letter,
           ;; so the rule fires *before* the Dvorak remap rewrites the keypress.
           [:!Tcomma :!Odelete_or_backspace [:!emacs :!terms :builtin]]   ;; Dvorak w
           [:!Tn     :!Oleft_arrow          [:!emacs :!terms :builtin]]   ;; Dvorak b
           [:!Ty     :!Oright_arrow         [:!emacs :!terms :builtin]]   ;; Dvorak f
           [:!Tj     :delete_or_backspace   [:!emacs :builtin]]]}         ;; Dvorak h

  {:des "Caps Lock: tap = Escape, hold = Control"
   :rules [;; ## means "optionally with any modifier"
           [:##caps_lock :left_control nil {:alone :escape}]]}

  {:des "Better Shifting: tap shift for ( or )"
   :rules [[:left_shift  {:key :left_shift  :lazy true} nil {:alone :!S9}]
           [:right_shift {:key :right_shift :lazy true} nil {:alone :!S0}]]}

  {:des "QWERTY -> Dvorak remap (built-in keyboard only)"
   ;; ## prefix = "optional: any modifier" — so the remap fires under modifier
   ;; combos too (e.g. ⌘⌥⌃C for Hammerspoon hotkeys). Without it, complex_mods
   ;; only match the bare key, and modified presses pass through unremapped.
   :rules [[:##b :x      [:builtin]] [:##c :j           [:builtin]]
           [:##d :e      [:builtin]] [:##e :period      [:builtin]]
           [:##f :u      [:builtin]] [:##g :i           [:builtin]]
           [:##h :d      [:builtin]] [:##i :c           [:builtin]]
           [:##j :h      [:builtin]] [:##k :t           [:builtin]]
           [:##l :n      [:builtin]] [:##n :b           [:builtin]]
           [:##o :r      [:builtin]] [:##p :l           [:builtin]]
           [:##q :quote  [:builtin]] [:##r :p           [:builtin]]
           [:##s :o      [:builtin]] [:##t :y           [:builtin]]
           [:##u :g      [:builtin]] [:##v :k           [:builtin]]
           [:##w :comma  [:builtin]] [:##x :q           [:builtin]]
           [:##y :f      [:builtin]] [:##z :semicolon   [:builtin]]
           [:##semicolon     :s            [:builtin]]
           [:##quote         :hyphen       [:builtin]]
           [:##comma         :w            [:builtin]]
           [:##period        :v            [:builtin]]
           [:##slash         :z            [:builtin]]
           [:##open_bracket  :slash        [:builtin]]
           [:##close_bracket :equal_sign   [:builtin]]
           [:##equal_sign    :close_bracket [:builtin]]
           [:##hyphen        :open_bracket [:builtin]]]}]}
